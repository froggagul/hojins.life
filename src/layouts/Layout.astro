---
import '@fontsource-variable/inter';
import '@fontsource-variable/noto-sans-kr';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { profile } from '../lib/content';
interface Props { title?: string; description?: string; active?: string; language?: string; published?: string; updated?: string; noindex?: boolean }
const { title = 'Hojin Jung · 정호진', description = 'Hojin Jung’s personal website. Writing about research and everyday life, and work in robotics, motion planning, and collision detection.', active = 'Home', language = 'en', published, updated, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname === '/404/' ? '/404.html' : Astro.url.pathname, Astro.site);
const nav = [{ label: 'Home', href: '/' }, { label: 'Blog', href: '/blog/' }, { label: 'Publications', href: '/publications/' }, { label: 'Projects', href: '/projects/' }, { label: 'CV', href: '/cv/' }];
---
<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f7f3" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Hojin Jung — Blog" href={new URL('/rss.xml', Astro.site)} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg" />
    <meta property="og:type" content={published ? 'article' : 'website'} />
    {published && <meta property="article:published_time" content={`${published}T00:00:00Z`} />}
    {updated && <meta property="article:modified_time" content={`${updated}T00:00:00Z`} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/social.jpg', Astro.site)} />
    <meta property="og:image:alt" content="Hojin Jung by the sea" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header shell">
      <a class="wordmark" href="/" aria-label="hojins.life home">hojins<span class="wordmark-dot">.</span>life</a>
      <nav aria-label="Main navigation">
        {nav.map(({ label, href }) => <a href={href} aria-current={active === label ? 'page' : undefined}>{label}</a>)}
        <a class="search-link" href="/search/" aria-label="Search writing, publications, and projects" aria-current={active === 'Search' ? 'page' : undefined}><Icon name="search" size={17} /><span>Search</span><kbd class="search-shortcut" aria-hidden="true" hidden></kbd></a>
      </nav>
    </header>
    <main id="main" class="shell"><slot /></main>
    <footer class="site-footer shell">
      <div><a href="/">Hojin Jung <span lang="ko">정호진</span></a></div>
      <div class="footer-right"><a href={`mailto:${profile.email}`}>Email <Icon name="external" size={14} /></a><a href={profile.github}>GitHub <Icon name="external" size={14} /></a><a href="/rss.xml">RSS</a><span class="copyright">© {new Date().getFullYear()}</span></div>
    </footer>
  </body>
</html>

<script>
  const searchLink = document.querySelector<HTMLAnchorElement>('.search-link')!;
  const shortcutHint = searchLink.querySelector<HTMLElement>('.search-shortcut')!;
  const isApple = /Mac|iPhone|iPad|iPod/.test(navigator.platform);
  shortcutHint.textContent = isApple ? '⌘ K' : 'Ctrl K';
  shortcutHint.hidden = false;
  searchLink.title = `Search (${isApple ? '⌘K' : 'Ctrl+K'})`;
  searchLink.setAttribute('aria-keyshortcuts', 'Control+k Meta+k');

  document.addEventListener('keydown', event => {
    if (event.defaultPrevented || event.isComposing || event.repeat || event.altKey || event.shiftKey) return;
    if (!(event.ctrlKey || event.metaKey) || (event.key.toLowerCase() !== 'k' && event.code !== 'KeyK')) return;

    event.preventDefault();
    const input = document.querySelector<HTMLInputElement>('#search-input');
    if (input) {
      input.focus();
      input.select();
    } else {
      const url = new URL(searchLink.href);
      url.hash = 'search-input';
      location.assign(url.href);
    }
  });
</script>
